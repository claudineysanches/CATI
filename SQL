-- TABELAS --

create table aluno (
    ra_aluno varchar2(8),
    nm_aluno varchar2(80),
    ds_curso varchar2(8),
    constraint aluno_pk primary key (ra_aluno),
    constraint aluno_nm_nn check(nm_aluno is not null)
);

create table evento(
    nm_evento varchar2(80),
    dt_inicio date,
    dt_fim date,
    constraint evento_pk primary key(nm_evento)
);

create table validador(
    ds_validador varchar2(13),
    nr_validador number(6),
    dt date default sysdate,
    constraint validador_pk primary key (ds_validador) 
);
create table frequencia(
    ra_aluno varchar2(8),
    dt_frequencia date default sysdate,
    ds_validador varchar2(13),
    nr_lat number(10,6),
    nr_lon number(10,6),
    constraint frequencia_pk primary key (ra_aluno,dt_frequencia,ds_validador),
    constraint frequencia_fk_ra_aluno foreign key(ra_aluno) references aluno(ra_aluno),
    constraint frequencia_fk_ds_validador foreign key(ds_validador) references validador(ds_validador)
);

create table artigo
(
    id_artigo number(4),
    sg_orientador char(2),
    sg_tipo char(3),
    ds_titulo varchar2(120),
    constraint artigo_uk unique (ds_titulo) 
);

alter table artigo add constraint artigo_pk primary key (id_artigo);

create table avaliacao (
    id_artigo number(4),
    p1 number(1),
    p2 number(1),
    p3 number(1),
    p4 number(1),
    p5 number(1),
    sg_avaliador varchar2(2),
    dt date default sysdate,
    constraint avaliacao_fk foreign key (id_artigo) references artigo (id_artigo)
);

-- SEQUENCIA --

create sequence cont_validador start with 43690 increment by 1 maxvalue 999999;
create sequence cont_artigo start with 4000 increment by 1 maxvalue 999999;

update artigo set id_artigo = cont_artigo.nextval;
select cont_artigo.nextval from dual;

-- PROCEDURES --

create or replace procedure proc_validador is
    novo_validador varchar2(12);
begin
    dbms_output.enable;
    novo_validador := ltrim(substr(to_char(cont_validador.nextval,'XXXX'),1,2)||to_char(sysdate,'yy')||substr(to_char(cont_validador.currval,'XXXX'),2,2)||to_char(sysdate,'mm')||substr(to_char(cont_validador.currval,'XXXX'),3,3)||to_char(sysdate,'dd'));
    dbms_output.put_line(novo_validador);
    insert into validador (ds_validador,nr_validador) values (novo_validador,cont_validador.currval);                
end;

begin
    proc_validador;
end;

create or replace procedure gerar_validador 
(
    maximo in number
) is
begin
    dbms_output.enable;
    for contar in 1..maximo
    loop
       proc_validador;
    end loop;
    dbms_output.put_line('Numeros Gerados');
end;

begin
   gerar_validador(10);
end;

create or replace procedure proc_avaliador is
begin
  update avaliacao set sg_avaliador = upper(sg_avaliador);
end;

begin
    proc_avaliador;
end;

