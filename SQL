-- VIEW --

create or replace view view_validador as
select ds_validador as validador, to_char(dt,'dd/mm/yyyy') as dia from validador; 

select * from view_validador where dia = '22/10/2024';

create or replace view view_quantidade as
select count(*) as quantidade, substr(sg_tipo,3,1) as Turno,  substr(sg_tipo,1,2) as Tipo from artigo group by substr(sg_tipo,3,1), substr(sg_tipo,1,2) order by  3 desc, 2;

select * from view_quantidade;

create or replace view view_Nota as
select av.id_artigo as "Artigo", ar.ds_titulo as "Titulo",
       --round(avg(p1)) as "Formatação", 
       --round(avg(p2)) as "QR Code", 
       --round(avg(p3)) as "Apresentação", 
       --round(avg(p4)) as "Cliente Real", 
       --round(avg(p5)) as "Viável",
       to_char(round(avg(p1))*0.04+round(avg(p2))*0.2+round(avg(p3))*0.04+round(avg(p4))*0.04+round(avg(p5))*0.04,'0D00') as "Nota Final" 
from avaliacao av
join artigo ar
on av.id_artigo = ar.id_artigo 
group by av.id_artigo, ar.ds_titulo
order by 3 desc;

select * from view_Nota;

create or replace view view_Avaliadores_Dia as
select upper(sg_avaliador) as "Sigla", count(*) as "Quantidade", to_char(dt,'dd/mm/yy') as "Dia"
from avaliacao
group by upper(sg_avaliador), to_char(dt,'dd/mm/yy')
order by 3;

create or replace view view_Avaliadores as
select upper(sg_avaliador) as "Sigla", count(*) as "Quantidade"
from avaliacao
group by upper(sg_avaliador)
order by 1;

