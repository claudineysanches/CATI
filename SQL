SELECT 
    ra_aluno, 
    nm_aluno, 
    nm_curso, 
    ds_filial, 
    SUM(quantidade) AS total 
FROM (
    -- Primeiro bloco: Frequência
    SELECT ra_aluno, nm_aluno, nm_curso, ds_filial, COUNT(*)*3 AS quantidade 
    FROM (
        SELECT f.ra_aluno, al.nm_aluno, f.dt_frequencia, al.nm_curso, al.ds_filial 
        FROM frequencia f 
        JOIN aluno al ON al.ra_aluno = f.ra_aluno 
    ) 
    GROUP BY ra_aluno, nm_aluno, nm_curso, ds_filial

    UNION ALL

    -- Segundo bloco: Aula
    SELECT ra_aluno, nm_aluno, nm_curso, ds_filial, COUNT(*)*3 AS quantidade 
    FROM (
        SELECT ra_aluno, nm_aluno, dt_frequencia, nm_curso, ds_filial 
        FROM aula
    ) 
    GROUP BY ra_aluno, nm_aluno, nm_curso, ds_filial
) dados_consolidados -- <--- Fechamos o parêntese principal e demos um apelido para a subquery
GROUP BY ra_aluno, nm_aluno, nm_curso, ds_filial
order by 4, 3, 2;
